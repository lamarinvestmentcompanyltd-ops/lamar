# Copy this file to `.env` (or set these as environment variables on your host).
# None of these are needed for local development - `python manage.py runserver`
# works without any of this. On Railway, set them under the service's Variables tab.

# --- Core security ---
DJANGO_SECRET_KEY=replace-with-a-real-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=lamarinvestment.rw,www.lamarinvestment.rw
# (On Railway its own *.up.railway.app address is allowed automatically.)

# --- First admin login (created once, on the first start) ---
DJANGO_SUPERUSER_USERNAME=lamaradmin
DJANGO_SUPERUSER_PASSWORD=choose-a-long-password
DJANGO_SUPERUSER_EMAIL=info@lamarinvestment.rw

# --- Email: inquiry notifications go to info@lamarinvestment.rw ---
# Railway Free/Trial/Hobby plans block SMTP, so use the Resend API there:
RESEND_API_KEY=re_xxxxxxxxxxxx
DEFAULT_FROM_EMAIL=Lamar Investment <info@lamarinvestment.rw>
LAMAR_NOTIFY_EMAIL=info@lamarinvestment.rw
# Only if your host allows SMTP (Railway Pro, a VPS, ...) you could use this instead:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-mail-host.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=info@lamarinvestment.rw
# EMAIL_HOST_PASSWORD=your-mailbox-password

# --- Where data lives ---
# On Railway: attach a Volume mounted at /data and nothing else is needed -
# the database and uploaded photos go there automatically.
# Elsewhere: point these at folders that survive redeploys.
# DJANGO_DB_PATH=/var/lib/lamar/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/lib/lamar/media
DJANGO_BEHIND_PROXY=True

# --- Analytics (optional) ---
GOOGLE_ANALYTICS_ID=
